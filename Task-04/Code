#include <stdio.h>
#include <stdlib.h>
#include <windows.h>

typedef struct
{
    int temperature;
    int humidity;
    int pressure;
} WeatherData;

int main(int argc, char *argv[])
{
    HANDLE readPipe, writePipe;
    SECURITY_ATTRIBUTES sa;
    STARTUPINFOA si;
    PROCESS_INFORMATION pi;
    char command[1024];
    char programPath[MAX_PATH];

    // Child process: Receive weather data
    if (argc == 2)
    {
        readPipe = (HANDLE)(uintptr_t)strtoull(argv[1], NULL, 10);

        WeatherData data;
        DWORD bytesRead;
        int count = 0;

        printf("\nWEATHER DATA ANALYZER\n");

        while (1)
        {
            char *ptr = (char *)&data;
            DWORD totalRead = 0;

            while (totalRead < sizeof(data))
            {
                if (!ReadFile(readPipe, ptr + totalRead,
                              sizeof(data) - totalRead,
                              &bytesRead, NULL) || bytesRead == 0)
                {
                    break;
                }

                totalRead += bytesRead;
            }

            if (totalRead == 0)
                break;

            if (totalRead != sizeof(data))
            {
                printf("Incomplete reading received\n");
                break;
            }

            count++;

            printf("\nReading %d\n", count);
            printf("Temperature: %d C\n", data.temperature);
            printf("Humidity: %d%%\n", data.humidity);
            printf("Pressure: %d hPa\n", data.pressure);
        }

        printf("\nTotal readings received: %d\n", count);

        CloseHandle(readPipe);
        return 0;
    }

    // Parent process: Send weather data
    WeatherData readings[3] = {
        {28, 65, 1012},
        {30, 70, 1010},
        {27, 60, 1015}
    };

    sa.nLength = sizeof(SECURITY_ATTRIBUTES);
    sa.bInheritHandle = TRUE;
    sa.lpSecurityDescriptor = NULL;

    if (!CreatePipe(&readPipe, &writePipe, &sa, 0))
    {
        printf("Pipe creation failed\n");
        return 1;
    }

    // Prevent child from inheriting the write end
    SetHandleInformation(writePipe, HANDLE_FLAG_INHERIT, 0);

    GetModuleFileNameA(NULL, programPath, MAX_PATH);

    sprintf(command, "\"%s\" %llu",
            programPath,
            (unsigned long long)(uintptr_t)readPipe);

    ZeroMemory(&si, sizeof(si));
    si.cb = sizeof(si);
    ZeroMemory(&pi, sizeof(pi));

    if (!CreateProcessA(NULL, command, NULL, NULL, TRUE,
                        0, NULL, NULL, &si, &pi))
    {
        printf("Process creation failed\n");
        CloseHandle(readPipe);
        CloseHandle(writePipe);
        return 1;
    }

    CloseHandle(readPipe);

    printf("WEATHER SENSOR\n");

    for (int i = 0; i < 3; i++)
    {
        DWORD bytesWritten;

        if (!WriteFile(writePipe, &readings[i],
                       sizeof(WeatherData),
                       &bytesWritten, NULL) ||
            bytesWritten != sizeof(WeatherData))
        {
            printf("Write failed\n");
            break;
        }

        printf("Sent weather reading %d\n", i + 1);
    }

    CloseHandle(writePipe);

    WaitForSingleObject(pi.hProcess, INFINITE);

    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);

    printf("\nData transmission completed.\n");

    return 0;
}

