
#include <stdio.h>
#include <string.h>

#define P 5
#define R 3

int avail[R] = {3, 3, 2};

int maxm[P][R] = {
    {7, 5, 3},
    {3, 2, 2},
    {9, 0, 2},
    {2, 2, 2},
    {4, 3, 3}
};

int alloc[P][R] = {
    {0, 1, 0},
    {2, 0, 0},
    {3, 0, 2},
    {2, 1, 1},
    {0, 0, 2}
};

int is_safe(int seq[P])
{
    int work[R], finish[P] = {0};
    int count = 0;

    memcpy(work, avail, sizeof(work));

    while (count < P)
    {
        int found = 0;

        for (int p = 0; p < P; p++)
        {
            if (!finish[p])
            {
                int r;

                for (r = 0; r < R; r++)
                {
                    int need = maxm[p][r] - alloc[p][r];

                    if (need > work[r])
                        break;
                }

                if (r == R)
                {
                    for (int k = 0; k < R; k++)
                        work[k] += alloc[p][k];

                    finish[p] = 1;
                    seq[count++] = p;
                    found = 1;
                }
            }
        }

        if (!found)
            return 0;
    }

    return 1;
}

void request(int p, int req[R])
{
    int r, seq[P];

    for (r = 0; r < R; r++)
    {
        if (req[r] > maxm[p][r] - alloc[p][r] ||
            req[r] > avail[r])
        {
            printf("P%d request: must wait (not available)\n", p);
            return;
        }
    }

    for (r = 0; r < R; r++)
    {
        avail[r] -= req[r];
        alloc[p][r] += req[r];
    }

    if (is_safe(seq))
    {
        printf("P%d request: granted, safe sequence: ", p);

        for (int i = 0; i < P; i++)
            printf("P%d ", seq[i]);

        printf("\n");
    }
    else
    {
        for (r = 0; r < R; r++)
        {
            avail[r] += req[r];
            alloc[p][r] -= req[r];
        }

        printf("P%d request: denied (unsafe)\n", p);
    }
}

int main(void)
{
    int seq[P];

    if (is_safe(seq))
    {
        printf("Initial state safe: ");

        for (int i = 0; i < P; i++)
            printf("P%d ", seq[i]);

        printf("\n");
    }

    request(1, (int[R]){1, 0, 2});
    request(4, (int[R]){3, 3, 0});
    request(0, (int[R]){0, 2, 0});

    return 0;
}
